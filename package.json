{
  "name": "sliderelay",
  "version": "1.0.1",
  "private": true,
  "description": "Broadcast your live PowerPoint slideshow to viewers' phones over the local Wi-Fi.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mk-manishkandel/SlideRelay.git"
  },
  "type": "module",
  "workspaces": [
    "shared",
    "addin",
    "viewer",
    "companion"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "icons": "node scripts/make-icons.mjs",
    "set-version": "node scripts/set-version.mjs",
    "dev:addin": "npm run dev -w addin",
    "dev:companion": "npm run tauri -w companion -- dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
